@model List<RaceDay.Mvc.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "RaceDay Events";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1>🏃 RaceDay Events</h1>
        <p class="lead">
            Discover upcoming running, walking and cycling events.
        </p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h4 class="card-title">
                                @item.EventName
                            </h4>

                            <p class="card-text">
                                @item.Description
                            </p>

                            <hr />

                            <p>
                                <strong>📅 Date:</strong>
                                @item.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>📍 Location:</strong>
                                @item.LocationName
                            </p>

                            <p>
                                <strong>🏁 Distance:</strong>
                                @item.DistanceKm km
                            </p>

                            <p>
                                <strong>🏆 Type:</strong>
                                @item.EventTypeName
                            </p>

                        </div>

                        <div class="card-footer bg-white">

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@item.EventID"
                               class="btn btn-primary w-100">
                                View Event
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
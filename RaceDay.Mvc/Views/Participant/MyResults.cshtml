@model List<RaceDay.Mvc.ViewModels.ResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">

    <h1>🏆 My Results</h1>

    <p class="lead">
        Your RaceDay event results.
    </p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No results are available yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>Result</th>
                        <th>Enrolment</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var result in Model)
                    {
                        <tr>

                            <td>
                                @result.ResultID
                            </td>

                            <td>
                                @result.EnrolmentID
                            </td>

                            <td>
                                @result.FinishTimeMinutes minutes
                            </td>

                            <td>
                                @result.Position
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
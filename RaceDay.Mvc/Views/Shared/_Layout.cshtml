<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay SA</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RaceDay.Mvc.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- RaceDay Logo / Brand -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    🏃 RaceDay SA
                </a>


                <!-- Mobile menu button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navigation -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <!-- Home -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>

                        </li>


                        <!-- Participant Navigation -->
                        @if (Context.Session.GetString("Role") == "Participant")
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Events"
                                   asp-action="Index">
                                    Events
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="MyEvents">
                                    My Events
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="MyResults">
                                    My Results
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Profile">
                                    Profile
                                </a>

                            </li>
                        }


                        <!-- Organiser Navigation -->
                        @if (Context.Session.GetString("Role") == "Organiser")
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Dashboard">
                                    Dashboard
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Events">
                                    Events
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Categories">
                                    Categories
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Enrolments">
                                    Enrolments
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Results">
                                    Results
                                </a>

                            </li>
                        }

                    </ul>


                    <!-- Right-hand User Navigation -->
                    <ul class="navbar-nav">

                        @if (!string.IsNullOrEmpty(
                                                Context.Session.GetString("UserID")))
                        {
                            <!-- Logged-in user -->
                            <li class="nav-item">

                                <span class="nav-link text-light">
                                    Hi,
                                    @Context.Session.GetString("FirstName")
                                </span>

                            </li>


                            <!-- Logout -->
                            <li class="nav-item">

                                <form asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-light btn-sm mt-1">
                                        Logout
                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <!-- Login -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Auth"
                                   asp-action="Login">
                                    Login
                                </a>

                            </li>


                            <!-- Register -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Auth"
                                   asp-action="Register">
                                    Register
                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- Main Page Content -->
    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- Footer -->
    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; @DateTime.Now.Year - RaceDay SA

            <span class="ms-2">|</span>

            <a asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>

        </div>

    </footer>


    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>